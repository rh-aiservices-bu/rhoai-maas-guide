apiVersion: v1
kind: ConfigMap
metadata:
  name: maas-gateway-options
  namespace: openshift-ingress
data:
  deployment: |
    spec:
      template:
        spec:
          containers:
          - name: istio-proxy
            env:
            - name: HTTP_PROXY
              value: "${HTTP_PROXY}"
            - name: HTTPS_PROXY
              value: "${HTTPS_PROXY}"
            - name: NO_PROXY
              value: "${NO_PROXY}"
            resources:
              requests:
                cpu: 100m
                memory: 256Mi
              limits:
                cpu: "2"
                memory: 2Gi
